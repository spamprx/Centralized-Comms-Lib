generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ── User ────────────────────────────────────────────────────────────────────
// Core identity for every authenticated actor.

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  /// Last authenticated API activity (throttled server-side); not the same as `updatedAt`.
  lastActiveAt DateTime?
  /// Client heartbeat while the app is open — drives “Active now” in admin for all signed-in users.
  presencePingAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userRoles        UserRole[]            @relation("UserRoles")
  assignedRoles    UserRole[]            @relation("RoleAssigner")
  groupMemberships UserGroupMembership[]

  authoredContent Content[]        @relation("ContentAuthor")
  contentVersions ContentVersion[] @relation("VersionAuthor")

  reviewRequests      ReviewRequest[]    @relation("ReviewRequester")
  reviewAssignments   ReviewAssignment[] @relation("AssignedReviewer")
  reviewAssignmentsBy ReviewAssignment[] @relation("AssignmentAssigner")
  reviewComments      ReviewComment[]    @relation("ReviewCommentAuthor")

  coAuthorAssignments ContentCoAuthor[] @relation("CoAuthorUser")
  coAuthorRequests    ContentCoAuthor[] @relation("CoAuthorRequester")

  auditLogs AuditLog[]

  authoredTemplates Template[] @relation("TemplateAuthor")
  contentSnapshots  ContentSnapshot[]
  contentAnnotations ContentAnnotation[] @relation("ContentAnnotationAuthor")
  contentBookmarks  ContentBookmark[] @relation("ContentBookmarkUser")
  contentComments   ContentComment[] @relation("ContentCommentAuthor")
  contentLikes      ContentLike[] @relation("ContentLikeUser")
  contentViews      ContentView[] @relation("ContentViewUser")

  @@map("users")
}

// ── Role ────────────────────────────────────────────────────────────────────
// Named permission bundle (Admin, Author, Reviewer, Audience, ...).

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]
  userRoles   UserRole[]

  @@map("roles")
}

// ── Permission ──────────────────────────────────────────────────────────────
// Single (action × resource) permission attached to a role.

model Permission {
  id       String @id @default(uuid())
  action   String // CREATE | READ | UPDATE | DELETE
  resource String // CONTENT | TEMPLATE | USER | ROLE | REVIEW | TAG | GROUP | LOG

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, action, resource])
  @@map("permissions")
}

// ── UserRole ────────────────────────────────────────────────────────────────
// Assignment of a role to a user, with audit details.

model UserRole {
  id         String   @id @default(uuid())
  assignedAt DateTime @default(now())

  userId String
  user   User   @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy   User?   @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ── UserGroup ───────────────────────────────────────────────────────────────
// Logical group of users for targeting and access control.

model UserGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships UserGroupMembership[]
  contents    Content[]             @relation("VisibilityGroup")

  @@map("user_groups")
}

// ── UserGroupMembership ─────────────────────────────────────────────────────
// Membership of a user in a group (many-to-many).

model UserGroupMembership {
  id       String   @id @default(uuid())
  joinedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String
  group   UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("user_group_memberships")
}

// ── AuditLog ────────────────────────────────────────────────────────────────
// Immutable audit entry for important actions.

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  resource   String
  resourceId String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── OutboxEvent ─────────────────────────────────────────────────────────────
// Transactional outbox entry for reliable event delivery.

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  retryCount    Int       @default(0)

  @@index([processedAt])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
  @@map("outbox_events")
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum LifecycleState {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
  HIDDEN
  ARCHIVED
  PRIVATE_TO_GROUP
}

enum VersionChangeType {
  MANUAL_SAVE
  STATE_TRANSITION
  RESTORE
  AI_GENERATED
}

enum ContentType {
  ARTICLE
  VIDEO
  PODCAST
  DOCUMENT
}

enum ReviewRequestStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ReviewAssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ReviewDecisionVerdict {
  APPROVED
  DENIED
  ROLLBACK
}

enum CoAuthorRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TemplateStatus {
  DRAFT
  ACTIVE
}

enum LayoutPhase {
  DRAFT
  ACTIVE
}

// ── Workspace ───────────────────────────────────────────────────────────────
// Isolation boundary for template name/slug uniqueness and future tenancy.

model Workspace {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates Template[]

  @@map("workspaces")
}

// ── Channel ─────────────────────────────────────────────────────────────────
// Delivery surface (web, email, push, …) referenced by template bindings.

model Channel {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique
  description String?
  priority    Int      @default(0)
  compatibility Json   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templateBindings TemplateChannelBinding[]
  contents         Content[]

  @@map("channels")
}

// ── Template ────────────────────────────────────────────────────────────────
// Layout + i18n bundle; draft vs active layouts for publish workflow.
// Name and slug are unique per workspace (clone-safe with suffix allocation).

model Template {
  id           String         @id @default(uuid())
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name         String
  slug         String
  description  String?
  status       TemplateStatus @default(DRAFT)
  draftLayout  Json?
  activeLayout Json?
  i18n         Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  authorId String
  author   User   @relation("TemplateAuthor", fields: [authorId], references: [id])

  bindings     TemplateChannelBinding[]
  contents     Content[]
  translations TemplateTranslation[]
  layoutSections TemplateLayoutSection[]
  formattingRule TemplateFormattingRule?

  @@unique([workspaceId, slug])
  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@index([authorId])
  @@map("templates")
}

// Normalized translations (indexed by template + locale). JSON i18n on Template remains for cache/legacy.

model TemplateTranslation {
  id         String   @id @default(uuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  locale     String
  key        String
  value      String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([templateId, locale, key])
  @@index([templateId, locale])
  @@map("template_translations")
}

// Registered UI/building-block components and immutable version rows with link references.

model Component {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions ComponentVersion[]

  @@map("components")
}

model ComponentVersion {
  id          String    @id @default(uuid())
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  version     String
  /// Canonical TipTap JSON for this version (used for linked inserts + library preview).
  bodyJson    Json?
  linkRefs    Json      @default("[]")
  propSchema  Json?
  createdAt   DateTime  @default(now())

  layoutSections TemplateLayoutSection[]

  @@unique([componentId, version])
  @@index([componentId])
  @@map("component_versions")
}

// Persisted template sections per layout phase; optional link to a component version.

model TemplateLayoutSection {
  id                 String            @id @default(uuid())
  templateId         String
  template           Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  phase              LayoutPhase
  sortOrder          Int
  componentVersionId String?
  componentVersion   ComponentVersion? @relation(fields: [componentVersionId], references: [id], onDelete: SetNull)
  props              Json              @default("{}")

  @@unique([templateId, phase, sortOrder])
  @@index([templateId, phase])
  @@index([componentVersionId])
  @@map("template_layout_sections")
}

// Optional per-template TipTap formatting constraints (fonts, colors, headings, media).
model TemplateFormattingRule {
  id         String   @id @default(uuid())
  templateId String   @unique
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rules      Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([updatedAt])
  @@index([rules], type: Gin)
  @@map("template_formatting_rules")
}

model TemplateChannelBinding {
  id String @id @default(uuid())

  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([templateId, channelId])
  @@index([channelId])
  @@map("template_channel_bindings")
}

// ── Content ─────────────────────────────────────────────────────────────────
// Main content record with lifecycle and visibility metadata.

model Content {
  id             String         @id @default(uuid())
  title          String
  slug           String         @unique
  lifecycleState LifecycleState @default(DRAFT)
  visibility     Visibility     @default(PRIVATE)
  contentType    ContentType    @default(ARTICLE)
  aiGenerated    Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  authorId String
  author   User   @relation("ContentAuthor", fields: [authorId], references: [id])

  visibilityGroupId String?
  visibilityGroup   UserGroup? @relation("VisibilityGroup", fields: [visibilityGroupId], references: [id], onDelete: SetNull)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  versions       ContentVersion[]
  tags           ContentTag[]
  reviewRequests ReviewRequest[]
  coAuthors      ContentCoAuthor[] @relation("ContentCoAuthors")
  citations      ContentCitation[]
  snapshots      ContentSnapshot[]
  analyticsEvents ContentAnalyticsEvent[]
  annotations   ContentAnnotation[] @relation("ContentAnnotations")
  bookmarks     ContentBookmark[] @relation("ContentBookmarks")
  comments      ContentComment[] @relation("ContentComments")
  likes         ContentLike[] @relation("ContentLikes")
  views         ContentView[] @relation("ContentViews")

  @@index([authorId])
  @@index([lifecycleState])
  @@index([visibility])
  @@index([createdAt])
  @@index([templateId])
  @@index([channelId])
  @@index([title])
  @@map("contents")
}

model ContentCitation {
  id            String   @id @default(uuid())
  contentId     String
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  referenceType String
  referenceId   String
  label         String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([contentId])
  @@index([referenceType, referenceId])
  @@map("content_citations")
}

// Point-in-time snapshot metadata; large diffs / bodies live in Mongo (mongoDocumentId).

model ContentSnapshot {
  id                String   @id @default(uuid())
  contentId         String
  content           Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  fromVersionNumber Int?
  toVersionNumber   Int
  diffMetadata      Json
  mongoDocumentId   String?
  createdAt         DateTime @default(now())
  createdById       String?
  createdBy         User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([contentId, createdAt])
  @@map("content_snapshots")
}

// Lightweight analytics events for per-content and aggregate reporting.
model ContentAnalyticsEvent {
  id        String   @id @default(uuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([contentId, createdAt])
  @@index([createdAt])
  @@map("content_analytics_events")
}

// ── ContentVersion ──────────────────────────────────────────────────────────
// Immutable snapshot of a content item at a point in time.

model ContentVersion {
  id               String            @id @default(uuid())
  versionNumber    Int
  changeType       VersionChangeType
  title            String
  body             Json?
  metadataSnapshot Json?
  createdAt        DateTime          @default(now())

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("VersionAuthor", fields: [authorId], references: [id])

  reviewRequests ReviewRequest[]

  @@unique([contentId, versionNumber])
  @@index([contentId])
  @@map("content_versions")
}

// ── ContentAnnotation ────────────────────────────────────────────────────────
// Reader annotations, optionally anchored to a specific text selection.
model ContentAnnotation {
  id        String   @id @default(uuid())
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentId String
  content   Content  @relation("ContentAnnotations", fields: [contentId], references: [id], onDelete: Cascade)

  authorId String
  author   User @relation("ContentAnnotationAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // ProseMirror positions at time of annotation; null means "general" note.
  selectionFrom Int?
  selectionTo   Int?
  selectionText String?

  @@index([contentId, createdAt])
  @@index([authorId, createdAt])
  @@map("content_annotations")
}

// ── ContentBookmark ─────────────────────────────────────────────────────────
// Saved/bookmarked content for a user (per-session persistent).
model ContentBookmark {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  contentId String
  content   Content  @relation("ContentBookmarks", fields: [contentId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation("ContentBookmarkUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contentId, userId])
  @@index([userId, createdAt])
  @@index([contentId, createdAt])
  @@map("content_bookmarks")
}

// ── ContentComment ──────────────────────────────────────────────────────────
// Reader comments on published content.
model ContentComment {
  id        String   @id @default(uuid())
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentId String
  content   Content  @relation("ContentComments", fields: [contentId], references: [id], onDelete: Cascade)

  authorId String
  author   User @relation("ContentCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@index([authorId, createdAt])
  @@map("content_comments")
}

// ── ContentLike ─────────────────────────────────────────────────────────────
// "Helpful" like toggle per user.
model ContentLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  contentId String
  content   Content  @relation("ContentLikes", fields: [contentId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation("ContentLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contentId, userId])
  @@index([userId, createdAt])
  @@index([contentId, createdAt])
  @@map("content_likes")
}

// ── ContentView ─────────────────────────────────────────────────────────────
// Legitimate views: counted once per browser-tab session (sessionId provided by client).
model ContentView {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  contentId String
  content   Content  @relation("ContentViews", fields: [contentId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation("ContentViewUser", fields: [userId], references: [id], onDelete: Cascade)

  sessionId String

  @@unique([contentId, sessionId])
  @@index([contentId, createdAt])
  @@index([userId, createdAt])
  @@map("content_views")
}

// ── Tag / ContentTag ────────────────────────────────────────────────────────
// Tags and their links to content, for search and organisation.

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  parentId  String?
  parent    Tag?     @relation("TagHierarchy", fields: [parentId], references: [id])
  children  Tag[]    @relation("TagHierarchy")
  createdAt DateTime @default(now())

  contents ContentTag[]

  @@map("tags")
}

model ContentTag {
  id         String   @id @default(uuid())
  assignedAt DateTime @default(now())

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contentId, tagId])
  @@map("content_tags")
}

// ── ReviewRequest ───────────────────────────────────────────────────────────
// Review request for a specific content version and quorum.

model ReviewRequest {
  id             String              @id @default(uuid())
  status         ReviewRequestStatus @default(OPEN)
  quorumRequired Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  contentId String
  content   Content @relation(fields: [contentId], references: [id])

  contentVersionId String
  contentVersion   ContentVersion @relation(fields: [contentVersionId], references: [id])

  requestedById String
  requestedBy   User   @relation("ReviewRequester", fields: [requestedById], references: [id])

  assignments ReviewAssignment[]

  @@index([contentId])
  @@index([status])
  @@map("review_requests")
}

// ── ReviewAssignment ────────────────────────────────────────────────────────
// Single reviewer assignment for a review request.

model ReviewAssignment {
  id          String                 @id @default(uuid())
  status      ReviewAssignmentStatus @default(PENDING)
  assignedAt  DateTime               @default(now())
  completedAt DateTime?

  reviewRequestId String
  reviewRequest   ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User   @relation("AssignedReviewer", fields: [reviewerId], references: [id])

  assignedById String
  assignedBy   User   @relation("AssignmentAssigner", fields: [assignedById], references: [id])

  decision ReviewDecision?
  comments ReviewComment[]

  @@unique([reviewRequestId, reviewerId])
  @@index([reviewerId])
  @@index([status])
  @@map("review_assignments")
}

// ── ReviewComment ────────────────────────────────────────────────────────────
// Standalone comment on an assignment without a verdict.

model ReviewComment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewAssignmentId String
  reviewAssignment   ReviewAssignment @relation(fields: [reviewAssignmentId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReviewCommentAuthor", fields: [authorId], references: [id])

  @@index([reviewAssignmentId])
  @@index([authorId])
  @@map("review_comments")
}

// ── ReviewDecision ──────────────────────────────────────────────────────────
// Final verdict for a review assignment, human or automated.

model ReviewDecision {
  id             String                @id @default(uuid())
  verdict        ReviewDecisionVerdict
  comment        String
  isAutoApproval Boolean               @default(false)
  decidedAt      DateTime              @default(now())

  reviewAssignmentId String           @unique
  reviewAssignment   ReviewAssignment @relation(fields: [reviewAssignmentId], references: [id], onDelete: Cascade)

  @@map("review_decisions")
}

model ContentCoAuthor {
  id        String                @id @default(uuid())
  status    CoAuthorRequestStatus @default(PENDING)
  createdAt DateTime              @default(now())
  decidedAt DateTime?

  contentId String
  content   Content @relation("ContentCoAuthors", fields: [contentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("CoAuthorUser", fields: [userId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("CoAuthorRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([contentId, userId])
  @@map("content_coauthors")
}
