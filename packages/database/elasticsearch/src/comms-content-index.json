{
  "settings": {
    "analysis": {
      "analyzer": {
        "comms_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "contentId": { "type": "keyword" },
      "workspaceId": { "type": "keyword" },
      "lifecycleState": { "type": "keyword" },
      "visibility": { "type": "keyword" },
      "authorId": { "type": "keyword" },
      "templateId": { "type": "keyword" },
      "channelIds": { "type": "keyword" },
      "tagIds": { "type": "keyword" },
      "tagSlugs": { "type": "keyword" },
      "aiGenerated": { "type": "boolean" },
      "title": {
        "type": "text",
        "analyzer": "comms_text",
        "fields": { "raw": { "type": "keyword", "ignore_above": 512 } }
      },
      "summary": {
        "type": "text",
        "analyzer": "comms_text"
      },
      "body": {
        "type": "text",
        "analyzer": "comms_text"
      },
      "bodyPlain": {
        "type": "text",
        "analyzer": "comms_text"
      },
      "tags": { "type": "keyword" },
      "slug": { "type": "keyword" },
      "publishedAt": { "type": "date" },
      "updatedAt": { "type": "date" },
      "createdAt": { "type": "date" },
      "indexedAt": { "type": "date" },
      "engagementScore": { "type": "integer" },
      "titleEmbedding": {
        "type": "dense_vector",
        "dims": 384,
        "index": true,
        "similarity": "cosine"
      }
    }
  }
}
