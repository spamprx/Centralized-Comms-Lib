{
  "settings": {
    "index": {
      "max_ngram_diff": 10
    },
    "analysis": {
      "filter": {
        "english_stem": {
          "type": "stemmer",
          "language": "english"
        },
        "comms_synonyms": {
          "type": "synonym_graph",
          "lenient": true,
          "synonyms": [
            "quick, fast, rapid",
            "content, article, post, story",
            "library, repository, catalog",
            "author, writer, creator",
            "review, audit, critique"
          ]
        },
        "edge_ngram_filter": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 15
        }
      },
      "analyzer": {
        "comms_text_index": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "english_stem"]
        },
        "comms_text_search": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "comms_synonyms", "english_stem"]
        },
        "comms_autocomplete": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "edge_ngram_filter"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "contentId": { "type": "keyword" },
      "workspaceId": { "type": "keyword" },
      "lifecycleState": { "type": "keyword" },
      "visibility": { "type": "keyword" },
      "authorId": { "type": "keyword" },
      "templateId": { "type": "keyword" },
      "channelIds": { "type": "keyword" },
      "tagIds": { "type": "keyword" },
      "tagSlugs": { "type": "keyword" },
      "aiGenerated": { "type": "boolean" },
      "title": {
        "type": "text",
        "analyzer": "comms_text_index",
        "search_analyzer": "comms_text_search",
        "fields": {
          "raw": { "type": "keyword", "ignore_above": 512 },
          "auto": { "type": "text", "analyzer": "comms_autocomplete", "search_analyzer": "standard" }
        }
      },
      "summary": {
        "type": "text",
        "analyzer": "comms_text_index",
        "search_analyzer": "comms_text_search"
      },
      "body": {
        "type": "text",
        "analyzer": "comms_text_index",
        "search_analyzer": "comms_text_search"
      },
      "bodyPlain": {
        "type": "text",
        "analyzer": "comms_text_index",
        "search_analyzer": "comms_text_search"
      },
      "tags": { "type": "keyword" },
      "slug": { "type": "keyword" },
      "publishedAt": { "type": "date" },
      "updatedAt": { "type": "date" },
      "createdAt": { "type": "date" },
      "indexedAt": { "type": "date" },
      "engagementScore": { "type": "integer" },
      "titleEmbedding": {
        "type": "dense_vector",
        "dims": 384,
        "index": true,
        "similarity": "cosine"
      }
    }
  }
}
