{
  "name": "swe-backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "prebuild": "node ../../infra/scripts/prep-api-build.js",
    "predev": "node ../../infra/scripts/prep-api-build.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "echo 'No lint configured'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist",
    "job:vector-reindex": "ts-node -r dotenv/config src/jobs/nightlyVectorReindex.ts",
    "job:link-scan": "ts-node -r dotenv/config src/jobs/assetLinkIntegrityScan.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@comms-lib/db-elasticsearch": "*",
    "@comms-lib/db-mongo": "*",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "diff": "^8.0.2",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.6.2",
    "google-translate-api-x": "^10.7.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.20.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.13",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/ws": "^8.18.1",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "keywords": [],
