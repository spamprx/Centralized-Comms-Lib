PORT=8000
NODE_ENV=development

# OpenAPI / Swagger "Try it out" base URL (use 127.0.0.1 if you open the UI at http://127.0.0.1:...)
REMOTE_URL=http://127.0.0.1:8000

JWT_SECRET=your-super-secret-key-change-in-production
JWT_ISSUER=your-app-name
JWT_AUDIENCE=your-app-client

# Comma-separated origins for CORS (required in production; dev defaults in app.ts if unset)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003,http://localhost:3004,http://127.0.0.1:3004,http://localhost:3005,http://127.0.0.1:3005,http://localhost:3006,http://127.0.0.1:3006,http://localhost:3007,http://127.0.0.1:3007,http://localhost:3008,http://127.0.0.1:3008,http://localhost:3009,http://127.0.0.1:3009,http://localhost:3010,http://127.0.0.1:3010

# Dev routes GET /dev/repo-check, POST /dev/reindex — send header X-Dev-Token matching this value
ADMIN_DEV_TOKEN=

# Bcrypt rounds for new passwords (clamped 10–15 in code)
BCRYPT_COST=12

# When true, auth cookies use Secure flag (use behind HTTPS only)
COOKIE_SECURE=false

REDIS_URL=redis://localhost:6379
# Client timeouts (search cache + future shared rate limits)
# REDIS_CONNECT_TIMEOUT_MS=10000
# REDIS_COMMAND_TIMEOUT_MS=5000

# Browse-mode search response cache (per-epoch keys); max stored JSON size per entry
# SEARCH_CACHE_TTL_SEC=90
# SEARCH_CACHE_MAX_VALUE_BYTES=262144

AI_DAILY_QUOTA=50
# Rolling window legacy env (unused when using Redis UTC-day keys in aiDraftQuota); kept for docs compatibility
AI_QUOTA_WINDOW_MS=86400000
# Shared workspace/org cap for AI-assisted drafts (0 = disabled)
# AI_ORG_DAILY_QUOTA=2000

# Prometheus (`GET /metrics`; set to false to disable scrape endpoint)
# METRICS_ENABLED=true

# Forward analytics `track` events to HTTP ingest (Grafana/Loki/Segment-style)
# ANALYTICS_INGEST_URL=https://your-collector.example.com/v1/events
# ANALYTICS_INGEST_API_KEY=

# Optional title embedding service for nightly reindex + vector refresh (384-dim cosine, see ES mapping)
# EMBEDDING_SERVICE_URL=http://localhost:8090
# EMBEDDING_SERVICE_PATH=/embed

# In-process scheduler (prefer external cron in production)
# ENABLE_NIGHTLY_VECTOR_REINDEX=false
# NIGHTLY_VECTOR_REINDEX_INITIAL_DELAY_MS=3600000
# ENABLE_OUTBOX_WORKER=true
# OUTBOX_POLL_INTERVAL_MS=10000
# OUTBOX_BATCH_SIZE=50
# ENABLE_ASSET_LINK_SCAN=true
# ASSET_LINK_SCAN_INTERVAL_MS=300000
# LINK_SCAN_BATCH_SIZE=100

DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Template isolation (slug "default" is created by seed)
DEFAULT_WORKSPACE_SLUG=default

# Optional: large snapshot blobs / layout documents (MongoDB)
# MONGODB_URI=mongodb://localhost:27017/comms

# Optional: full-text search (Elasticsearch 8.x)
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_CONTENT_INDEX=comms-content

# F-SRC-001 Content-check similarity thresholds
# Min ES score for the existing-document (contentId) mode
# CONTENT_CHECK_MIN_SCORE=10.5
# Min ES score for the text-based (title/summary/body) mode
# CONTENT_CHECK_TEXT_MIN_SCORE=5
# Max body chars sent to ES (longer text is truncated)
# CONTENT_CHECK_BODY_MAX_CHARS=8000
# Combined title+summary+body length below this → "Not enough information"
# CONTENT_CHECK_MIN_INPUT_LEN=12

# Object storage (MinIO / S3-compatible) — presigned uploads from the web app
# MINIO_ENDPOINT=http://minio:9000
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_REGION=us-east-1
# MINIO_BUCKET_IMAGES=images
# MINIO_BUCKET_DOCUMENTS=documents
# MINIO_BUCKET_VIDEOS=videos
# MINIO_PRESIGN_PUT_EXPIRES_SEC=900
# MINIO_PRESIGN_GET_MAX_EXPIRES_SEC=604800
# MINIO_SHARE_LINK_EXPIRES_SEC=86400

# Notification framework integration (WhatsApp/email dispatch)
# NOTIFY_SERVER_URL=http://host.docker.internal:18000/notify
# NOTIFY_CLIENT_ID=
# NOTIFY_API_KEY=

# Firebase Cloud Messaging (web push)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_WEB_PUSH_VAPID_KEY=

# Firebase Admin (server-to-server push send via FCM HTTP v1)
FIREBASE_SERVICE_ACCOUNT_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional alternative: whole service account JSON as one escaped-line env var
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
# Optional alternative: path to service account JSON file (inside container filesystem)
# FIREBASE_SERVICE_ACCOUNT_JSON_PATH=./comms.json