PORT=8000
NODE_ENV=development

# OpenAPI / Swagger "Try it out" base URL (use 127.0.0.1 if you open the UI at http://127.0.0.1:...)
REMOTE_URL=http://127.0.0.1:8000

JWT_SECRET=your-super-secret-key-change-in-production
JWT_ISSUER=your-app-name
JWT_AUDIENCE=your-app-client

REDIS_URL=redis://localhost:6379
# Client timeouts (search cache + future shared rate limits)
# REDIS_CONNECT_TIMEOUT_MS=10000
# REDIS_COMMAND_TIMEOUT_MS=5000

# Browse-mode search response cache (per-epoch keys); max stored JSON size per entry
# SEARCH_CACHE_TTL_SEC=90
# SEARCH_CACHE_MAX_VALUE_BYTES=262144

AI_DAILY_QUOTA=50
# Rolling window legacy env (unused when using Redis UTC-day keys in aiDraftQuota); kept for docs compatibility
AI_QUOTA_WINDOW_MS=86400000
# Shared workspace/org cap for AI-assisted drafts (0 = disabled)
# AI_ORG_DAILY_QUOTA=2000

